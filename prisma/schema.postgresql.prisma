generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  TUTOR
}
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  GRADUATED
}

model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  cycles    SchoolCycle[]
  subjects  Subject[]
  groups    Group[]
  evaluationPeriods EvaluationPeriod[]
  incidents Incident[]
  notifications Notification[]
  calendarEvents CalendarEvent[]
  messages Message[]
  settings SchoolSettings?
  auditLogs AuditLog[]
  integrations IntegrationSource[]
  subscription SchoolSubscription?
}

model User {
  id           String     @id @default(cuid())
  schoolId     String
  school       School     @relation(fields: [schoolId], references: [id])
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)
  studentCode  String?    @unique
  employeeCode String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  enrollments  Enrollment[]
  teaching     TeachingAssignment[]
  guardianOf   GuardianStudent[] @relation("Guardian")
  guardians    GuardianStudent[] @relation("Student")
  grades       Grade[]
  attendance   AttendanceRecord[]
  taskSubmissions TaskSubmission[]
  reportedIncidents Incident[] @relation("IncidentReporter")
  studentIncidents  Incident[] @relation("IncidentStudent")
  notifications Notification[]
  sentMessages Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageRecipient")
  examAttempts ExamAttempt[]
  auditLogs AuditLog[] @relation("AuditActor")
  failedLoginCount Int @default(0)
  lockedUntil DateTime?
  lastLoginAt DateTime?
  lastLoginIp String?
  passwordChangedAt DateTime?
  mustChangePassword Boolean @default(false)

  @@index([schoolId, role])
}

model SchoolCycle {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  startDate DateTime
  endDate   DateTime
  active    Boolean  @default(false)
  groups    Group[]
  evaluationPeriods EvaluationPeriod[]

  @@unique([schoolId, name])
}

model Group {
  id        String      @id @default(cuid())
  schoolId  String
  cycleId   String
  school    School      @relation(fields: [schoolId], references: [id])
  cycle     SchoolCycle @relation(fields: [cycleId], references: [id])
  grade     Int
  name      String
  room      String?
  active    Boolean     @default(true)
  enrollments Enrollment[]
  teaching    TeachingAssignment[]

  @@unique([cycleId, grade, name])
}

model Subject {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  name        String
  code        String
  description String?
  active      Boolean  @default(true)
  teaching    TeachingAssignment[]

  @@unique([schoolId, code])
}

model Enrollment {
  id        String           @id @default(cuid())
  studentId String
  groupId   String
  student   User             @relation(fields: [studentId], references: [id])
  group     Group            @relation(fields: [groupId], references: [id])
  status    EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime        @default(now())

  @@unique([studentId, groupId])
}

model TeachingAssignment {
  id        String  @id @default(cuid())
  teacherId String
  groupId   String
  subjectId String
  teacher   User    @relation(fields: [teacherId], references: [id])
  group     Group   @relation(fields: [groupId], references: [id])
  subject   Subject @relation(fields: [subjectId], references: [id])
  grades     Grade[]
  attendance AttendanceRecord[]
  tasks      AcademicTask[]
  schedule   ScheduleEntry[]
  exams      Exam[]

  @@unique([teacherId, groupId, subjectId])
  @@index([groupId, subjectId])
}

model GuardianStudent {
  guardianId String
  studentId  String
  guardian   User @relation("Guardian", fields: [guardianId], references: [id])
  student    User @relation("Student", fields: [studentId], references: [id])
  createdAt  DateTime @default(now())

  @@id([guardianId, studentId])
  @@index([studentId])
}


model Grade {
  id                   String             @id @default(cuid())
  teachingAssignmentId String
  studentId            String
  period               Int                @default(1)
  score                Float
  comment              String?
  updatedAt            DateTime           @default(now()) @updatedAt
  teachingAssignment   TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  student              User               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teachingAssignmentId, studentId, period])
  @@index([studentId])
}

model AttendanceRecord {
  id                   String             @id @default(cuid())
  teachingAssignmentId String
  studentId            String
  date                 DateTime
  status               String             @default("PRESENT")
  note                 String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  teachingAssignment   TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  student              User               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teachingAssignmentId, studentId, date])
  @@index([studentId, date])
}

model AcademicTask {
  id                   String             @id @default(cuid())
  teachingAssignmentId String
  title                String
  description          String?
  dueDate              DateTime
  maxScore             Float?
  active               Boolean            @default(true)
  status               String             @default("PUBLISHED")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt
  teachingAssignment   TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  attachments          TaskAttachment[]
  submissions          TaskSubmission[]

  @@index([teachingAssignmentId, dueDate])
}

model TaskAttachment {
  id        String       @id @default(cuid())
  taskId    String
  task      AcademicTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name      String
  url       String
  pathname  String
  mimeType  String?
  size      Int
  createdAt DateTime     @default(now())

  @@index([taskId])
}

model TaskSubmission {
  id          String       @id @default(cuid())
  taskId      String
  studentId   String
  task        AcademicTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student     User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status      String       @default("SUBMITTED")
  submittedAt DateTime?
  score       Float?
  feedback    String?
  gradedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attachments SubmissionAttachment[]

  @@unique([taskId, studentId])
  @@index([studentId, status])
}

model SubmissionAttachment {
  id           String         @id @default(cuid())
  submissionId String
  submission   TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  name         String
  url          String
  pathname     String
  mimeType     String?
  size         Int
  createdAt    DateTime       @default(now())

  @@index([submissionId])
}


model EvaluationPeriod {
  id        String      @id @default(cuid())
  schoolId  String
  cycleId   String
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cycle     SchoolCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  name      String
  number    Int
  startDate DateTime
  endDate   DateTime
  open      Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@unique([cycleId, number])
  @@index([schoolId, open])
}

model ScheduleEntry {
  id                   String             @id @default(cuid())
  teachingAssignmentId String
  teachingAssignment   TeachingAssignment @relation(fields: [teachingAssignmentId], references: [id], onDelete: Cascade)
  dayOfWeek            Int
  startTime            String
  endTime              String
  room                  String?
  active                Boolean            @default(true)

  @@unique([teachingAssignmentId, dayOfWeek, startTime])
  @@index([dayOfWeek, startTime])
}

model Incident {
  id          String   @id @default(cuid())
  schoolId    String
  studentId   String
  reporterId  String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     User     @relation("IncidentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  reporter    User     @relation("IncidentReporter", fields: [reporterId], references: [id])
  category    String
  severity    String   @default("LOW")
  description String
  status      String   @default("OPEN")
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, status])
  @@index([studentId, occurredAt])
}


model Notification {
  id          String   @id @default(cuid())
  schoolId    String
  recipientId String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        String
  title       String
  message     String
  link        String?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([recipientId, readAt, createdAt])
  @@index([schoolId, createdAt])
}


model CalendarEvent {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  description String?
  type        String   @default("SCHOOL")
  startAt     DateTime
  endAt       DateTime?
  audience    String   @default("ALL")
  groupId     String?
  createdById String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([schoolId, startAt])
  @@index([groupId, startAt])
}


model Message {
  id          String   @id @default(cuid())
  schoolId    String
  senderId    String
  recipientId String
  subject     String?
  body        String
  readAt      DateTime?
  createdAt   DateTime @default(now())
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
  @@index([senderId, createdAt])
  @@index([schoolId, createdAt])
}


model Exam {
  id String @id @default(cuid())
  teachingAssignmentId String
  teachingAssignment TeachingAssignment @relation(fields:[teachingAssignmentId], references:[id], onDelete:Cascade)
  title String
  description String?
  opensAt DateTime
  closesAt DateTime
  durationMinutes Int @default(30)
  maxAttempts Int @default(1)
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  questions ExamQuestion[]
  attempts ExamAttempt[]
  @@index([teachingAssignmentId, opensAt])
}
model ExamQuestion {
  id String @id @default(cuid())
  examId String
  exam Exam @relation(fields:[examId], references:[id], onDelete:Cascade)
  type String @default("MULTIPLE_CHOICE")
  prompt String
  optionsJson String?
  correctAnswer String?
  points Float @default(1)
  position Int @default(1)
  answers ExamAnswer[]
  @@index([examId, position])
}
model ExamAttempt {
  id String @id @default(cuid())
  examId String
  studentId String
  exam Exam @relation(fields:[examId], references:[id], onDelete:Cascade)
  student User @relation(fields:[studentId], references:[id], onDelete:Cascade)
  attemptNumber Int @default(1)
  startedAt DateTime @default(now())
  submittedAt DateTime?
  objectiveScore Float?
  finalScore Float?
  status String @default("IN_PROGRESS")
  answers ExamAnswer[]
  @@unique([examId, studentId, attemptNumber])
  @@index([studentId, status])
}
model ExamAnswer {
  id String @id @default(cuid())
  attemptId String
  questionId String
  attempt ExamAttempt @relation(fields:[attemptId], references:[id], onDelete:Cascade)
  question ExamQuestion @relation(fields:[questionId], references:[id], onDelete:Cascade)
  answer String?
  awardedPoints Float?
  feedback String?
  @@unique([attemptId, questionId])
}


model SchoolSettings {
  id             String   @id @default(cuid())
  schoolId       String   @unique
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  displayName    String?
  shortName      String?
  logoUrl        String?
  logoPath       String?
  primaryColor   String   @default("#3155E7")
  secondaryColor String   @default("#0B1422")
  accentColor    String   @default("#8093FF")
  contactEmail   String?
  phone          String?
  website        String?
  address        String?
  city           String?
  state          String?
  country        String   @default("México")
  postalCode     String?
  timezone       String   @default("America/Mexico_City")
  locale         String   @default("es-MX")
  reportFooter   String?
  showPoweredBy  Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String
  actorId   String?
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  summary   String
  details   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([actorId, createdAt])
  @@index([entity, entityId])
}

model IntegrationSource {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  type        String   @default("API")
  status      String   @default("ACTIVE")
  baseUrl     String?
  configJson  String?
  tokenHash   String?
  tokenPrefix String?
  lastSyncAt  DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  syncRuns    SyncRun[]

  @@unique([schoolId, name])
  @@index([schoolId, status])
}

model SyncRun {
  id            String            @id @default(cuid())
  integrationId String
  integration   IntegrationSource @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  status        String            @default("SUCCESS")
  received      Int               @default(0)
  created       Int               @default(0)
  updated       Int               @default(0)
  skipped       Int               @default(0)
  failed        Int               @default(0)
  summary       String?
  startedAt     DateTime          @default(now())
  completedAt   DateTime?

  @@index([integrationId, startedAt])
}

model SchoolSubscription {
  id           String   @id @default(cuid())
  schoolId     String   @unique
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan         String   @default("DEMO")
  status       String   @default("ACTIVE")
  maxStudents  Int      @default(1000)
  maxStaff     Int      @default(200)
  featuresJson String?
  validUntil   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
